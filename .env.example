# Copy this file to .env.local and fill in values locally.
# .env.local is never committed. Real values are stored in Bitwarden
# and, for production, set in the Vercel dashboard.
# Never put secret values in this file.

# Supabase (project KMVISA FLIGHTS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Never use in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Flight data provider (fill in after the provider is chosen)
FLIGHT_PROVIDER=
FLIGHT_PROVIDER_API_KEY=

# Cache lifetime for search results, in minutes
FLIGHT_CACHE_MINUTES=30
